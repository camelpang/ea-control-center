POSTGRES_DB=ea_control
POSTGRES_USER=ea_user
POSTGRES_PASSWORD=change_this_password
DATABASE_URL=postgresql+psycopg://ea_user:change_this_password@postgres:5432/ea_control

# MVP simple API tokens. Change these before exposing real trading controls.
# Production checklist:
# - Use long random values for EA_API_TOKEN, ADMIN_API_TOKEN, and JWT_SECRET.
# - Prefer dedicated per-EA tokens generated from /ea-accounts for live accounts.
# - Keep ALLOW_PUBLIC_DASHBOARD_PREVIEW disabled unless a public demo wall is intended.
EA_API_TOKEN=change_this_ea_token
ADMIN_API_TOKEN=change_this_admin_token
EA_OFFLINE_SECONDS=60
COMMAND_TIMEOUT_SECONDS=120
MAX_MANUAL_ORDER_VOLUME=10.0
# Comma-separated whitelist. Default system policy is gold-only trading.
ALLOWED_TRADE_SYMBOLS=XAUUSD

# JWT for /api/auth/login (management users). Change in production.
JWT_SECRET=change_this_jwt_secret
JWT_EXPIRE_MINUTES=1440

# Optional: allow unauthenticated /api/dashboard-preview for TV-wall layout (default true in dev).
# Recommended production value:
ALLOW_PUBLIC_DASHBOARD_PREVIEW=false
